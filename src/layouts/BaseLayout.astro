---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Marketing with agentic systems for B2B companies with complex, high-value sales.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta id="theme-color" name="theme-color" content="#000A19" />
    <script is:inline>
      (() => {
        const saved = localStorage.getItem('agenticpath-theme');
        const theme = saved || 'dark';
        document.documentElement.dataset.theme = theme;
        const meta = document.getElementById('theme-color');
        if (meta) meta.content = theme === 'dark' ? '#000A19' : '#FAFFEB';
      })();
    </script>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="favicon-32.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Space+Grotesk:wght@300;500;700&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/dseg@0.46.0/css/dseg.css" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site">
      <a class="mark" href="./">AgenticPath<span class="mark-stop" aria-hidden="true"></span></a>
      <div class="header-actions">
        <a class="header-cta" href="#contact">Get in touch</a>
        <button id="btn-menu" class="icon-btn" aria-label="Open section menu" aria-expanded="false" aria-controls="section-menu">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
        </button>
      </div>
      <div id="section-menu" class="section-menu" hidden></div>
    </header>
    <slot />
    <footer class="site">
      <img class="wordmark wordmark-light" src="wordmark.png" alt="AgenticPath" />
      <img class="wordmark wordmark-dark" src="wordmark-mono-paper-on-ink.png" alt="AgenticPath" />
      <p class="muted">AgenticPath is a working name for now.</p>
    </footer>
    <script is:inline>
      const btnMenu = document.getElementById('btn-menu');
      const sectionMenu = document.getElementById('section-menu');
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

      const menuItems = [
        ['top', 'Top'],
        ['who', 'Who is it for'],
        ['who-we-are', 'Who we are'],
        ['engagement', 'The engagement'],
        ['problem', 'The problem'],
        ['contact', 'Talk to us'],
      ];

      function closeMenu() {
        sectionMenu.hidden = true;
        btnMenu.setAttribute('aria-expanded', 'false');
        btnMenu.setAttribute('aria-label', 'Open section menu');
      }

      function buildMenu() {
        sectionMenu.innerHTML = '';
        for (const [id, label] of menuItems) {
          const a = document.createElement('a');
          a.textContent = label;
          a.href = '#';
          a.addEventListener('click', (e) => {
            e.preventDefault();
            closeMenu();
            if (id === 'top') {
              window.scrollTo({ top: 0, behavior: reduceMotion.matches ? 'auto' : 'smooth' });
              return;
            }
            const el = document.getElementById(id);
            if (el) {
              el.scrollIntoView({ behavior: reduceMotion.matches ? 'auto' : 'smooth', block: 'start' });
              el.focus({ preventScroll: true });
            }
          });
          sectionMenu.appendChild(a);
        }
        const modeBtn = document.createElement('button');
        modeBtn.type = 'button';
        modeBtn.className = 'menu-mode';
        const dark = document.documentElement.dataset.theme === 'dark';
        modeBtn.setAttribute('aria-label', dark ? 'Switch to light mode' : 'Switch to dark mode');
        modeBtn.innerHTML = '<svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"/></svg><svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg><span>' + (dark ? 'Light mode' : 'Dark mode') + '</span>';
        modeBtn.addEventListener('click', () => {
          applyTheme(document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark');
          closeMenu();
        });
        sectionMenu.appendChild(modeBtn);
      }

      btnMenu.addEventListener('click', (e) => {
        e.stopPropagation();
        if (sectionMenu.hidden) {
          buildMenu();
          sectionMenu.hidden = false;
          btnMenu.setAttribute('aria-expanded', 'true');
          btnMenu.setAttribute('aria-label', 'Close section menu');
        } else {
          closeMenu();
        }
      });
      document.addEventListener('click', (e) => {
        if (!sectionMenu.hidden && !sectionMenu.contains(e.target)) closeMenu();
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeMenu();
      });

      function applyTheme(theme) {
        document.documentElement.dataset.theme = theme;
        localStorage.setItem('agenticpath-theme', theme);
        const meta = document.getElementById('theme-color');
        if (meta) meta.content = theme === 'dark' ? '#000A19' : '#FAFFEB';
      }
      applyTheme(document.documentElement.dataset.theme || 'light');

      // Journey diagram: light up each stop while the traveller overlaps it.
      // Driven by the dot's real position, so the light-up can never drift
      // out of step with the dot the way timed keyframes did.
      const journey = document.querySelector('.journey');
      const journeyDot = document.getElementById('journey-dot');
      const journeyNodes = [1, 2, 3].map((n) => document.querySelector('.journey .node-' + n));
      const reduceMotionJourney = window.matchMedia('(prefers-reduced-motion: reduce)');
      if (journey && journeyDot && journeyNodes.every(Boolean) && !reduceMotionJourney.matches) {
        const syncJourney = () => {
          const scale = journey.getBoundingClientRect().width / 760;
          const dot = journeyDot.getBoundingClientRect();
          const dotX = dot.left + dot.width / 2;
          const dotY = dot.top + dot.height / 2;
          let anyLit = false;
          journeyNodes.forEach((g) => {
            const c = g.querySelector('.node').getBoundingClientRect();
            const cx = c.left + c.width / 2;
            const cy = c.top + c.height / 2;
            const lit = Math.abs(dotX - cx) < 27 * scale && Math.abs(dotY - cy) < 27 * scale;
            g.classList.toggle('lit', lit);
            if (lit) anyLit = true;
          });
          journeyDot.classList.toggle('hidden', anyLit);
          requestAnimationFrame(syncJourney);
        };
        requestAnimationFrame(syncJourney);
      }

      // Hero tagline: the second digit flips 0 to 1 like a digital clock, the first stays 0.
      const digitB = document.getElementById('digit-b');
      const reduceMotionFlip = window.matchMedia('(prefers-reduced-motion: reduce)');
      if (digitB && !reduceMotionFlip.matches) {
        setInterval(() => {
          digitB.classList.add('flipping');
          setTimeout(() => {
            digitB.textContent = digitB.textContent === '0' ? '1' : '0';
          }, 300);
          setTimeout(() => {
            digitB.classList.remove('flipping');
          }, 600);
        }, 2400);
      }
    </script>
  </body>
</html>
