---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Marketing with agentic systems for B2B companies with complex, high-value sales.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta id="theme-color" name="theme-color" content="#000A19" />
    <script is:inline>
      (() => {
        const saved = localStorage.getItem('agenticpath-theme');
        const theme = saved || 'dark';
        document.documentElement.dataset.theme = theme;
        const meta = document.getElementById('theme-color');
        if (meta) meta.content = theme === 'dark' ? '#000A19' : '#FAFFEB';
      })();
    </script>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="favicon-32.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <link rel="preload" href="fonts/opentui-mono-latin-400.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href="fonts/opentui-mono-latin-700.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/dseg@0.46.0/css/dseg.css" />
    <title>{title}</title>
  </head>
  <body>
    <div class="shell">
      <aside class="rail">
        <a class="rail-mark" href="#top" aria-label="AgenticPath home">A</a>
        <div class="rail-name">AgenticPath</div>
        <nav aria-label="Sections">
          <a href="#product" data-spy="product"><span class="num">[1]</span>Product</a>
          <a href="#who" data-spy="who"><span class="num">[2]</span>Who is it for</a>
          <a href="#problem" data-spy="problem"><span class="num">[3]</span>The problem</a>
          <a href="#engagement" data-spy="engagement"><span class="num">[4]</span>The engagement</a>
          <a href="#how" data-spy="how"><span class="num">[5]</span>How we work</a>
          <a href="#contact" data-spy="contact"><span class="num">[6]</span>Talk to us</a>
        </nav>
        <div class="rail-foot">
          <button id="btn-theme" class="theme-toggle" type="button">
            <span class="num">[ ]</span>
            <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"/></svg><svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg><span id="theme-label">Light mode</span>
          </button>
          <div class="status-line">
            <span class="status-bars" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
            Accepting first clients
          </div>
        </div>
        <div class="rail-copy">©2026 AgenticPath</div>
      </aside>
      <main class="content" id="top">
        <div class="content-inner">
          <slot />
          <footer class="site">
            <div class="foot-word" aria-hidden="true">AGENTICPATH</div>
            <div class="foot-meta">
              <span>©2026 AgenticPath</span>
              <span>Founders, Amir Baruch and Kayan</span>
              <span>B2B / long sales cycles / €100K+ deals</span>
              <span>AgenticPath is a working name for now.</span>
              <a href="#top">Back to top</a>
            </div>
          </footer>
        </div>
      </main>
    </div>
    <script is:inline>
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

      // Theme toggle, in the rail foot. Dark is the default.
      const btnTheme = document.getElementById('btn-theme');
      const themeLabel = document.getElementById('theme-label');
      function syncThemeLabel() {
        const dark = document.documentElement.dataset.theme === 'dark';
        if (themeLabel) themeLabel.textContent = dark ? 'Light mode' : 'Dark mode';
      }
      function applyTheme(theme) {
        document.documentElement.dataset.theme = theme;
        localStorage.setItem('agenticpath-theme', theme);
        const meta = document.getElementById('theme-color');
        if (meta) meta.content = theme === 'dark' ? '#000A19' : '#FAFFEB';
        syncThemeLabel();
      }
      if (btnTheme) {
        btnTheme.addEventListener('click', () => {
          applyTheme(document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark');
        });
      }
      syncThemeLabel();

      // Journey diagram: light up each stop while the traveller overlaps it.
      // Driven by the dot's real position, so the light-up can never drift
      // out of step with the dot the way timed keyframes did.
      const journey = document.querySelector('.journey');
      const journeyDot = document.getElementById('journey-dot');
      const journeyNodes = [1, 2, 3].map((n) => document.querySelector('.journey .node-' + n));
      if (journey && journeyDot && journeyNodes.every(Boolean) && !reduceMotion.matches) {
        const syncJourney = () => {
          const scale = journey.getBoundingClientRect().width / 760;
          const dot = journeyDot.getBoundingClientRect();
          const dotX = dot.left + dot.width / 2;
          const dotY = dot.top + dot.height / 2;
          let anyLit = false;
          journeyNodes.forEach((g) => {
            const c = g.querySelector('.node').getBoundingClientRect();
            const cx = c.left + c.width / 2;
            const cy = c.top + c.height / 2;
            const lit = Math.abs(dotX - cx) < 27 * scale && Math.abs(dotY - cy) < 27 * scale;
            g.classList.toggle('lit', lit);
            if (lit) anyLit = true;
          });
          journeyDot.classList.toggle('hidden', anyLit);
          requestAnimationFrame(syncJourney);
        };
        requestAnimationFrame(syncJourney);
      }

      // Hero tagline: the second digit flips 0 to 1 like a digital clock, the first stays 0.
      const digitB = document.getElementById('digit-b');
      if (digitB && !reduceMotion.matches) {
        setInterval(() => {
          digitB.classList.add('flipping');
          setTimeout(() => {
            digitB.textContent = digitB.textContent === '0' ? '1' : '0';
          }, 300);
          setTimeout(() => {
            digitB.classList.remove('flipping');
          }, 600);
        }, 2400);
      }

      // Terminal panel, typed agent workflow. Static full text when motion is reduced.
      (function () {
        var body = document.getElementById('term-body');
        if (!body) return;
        var lines = [
          { html: '<span class="t-prompt">&gt;</span> audit.run <span class="t-dim">--client b2b-services</span>' },
          { html: '<span class="t-dim">  reading funnel, ads, CRM...</span>' },
          { html: '<span class="t-dim">  14 findings, ranked by impact</span>' },
          { html: '<span class="t-prompt">&gt;</span> draft.outreach <span class="t-dim">--accounts 25</span>' },
          { html: '<span class="t-blue">  Build</span> <span class="t-dim"> · sequence v2, awaiting approval</span>' },
          { html: '<span class="t-prompt">&gt;</span> report.weekly' },
          { html: '<span class="t-dim">  pipeline + pacing, sent to client</span>' },
          { html: '<span class="t-dim">  esc interrupt, a human decides</span>' }
        ];
        function renderFull() {
          body.innerHTML = lines.map(function (l) { return '<div class="t-line">' + l.html + '</div>'; }).join('');
        }
        if (reduceMotion.matches) { renderFull(); return; }
        // Show the finished run first, then replay it typed after a pause.
        renderFull();
        setTimeout(function () { body.innerHTML = ''; newLine(); tick(); }, 7000);
        var plain = [
          '> audit.run --client b2b-services',
          '  reading funnel, ads, CRM...',
          '  14 findings, ranked by impact',
          '> draft.outreach --accounts 25',
          '  Build · sequence v2, awaiting approval',
          '> report.weekly',
          '  pipeline + pacing, sent to client',
          '  esc interrupt, a human decides'
        ];
        var lineIdx = 0, charIdx = 0, current = null;
        function newLine() {
          current = document.createElement('div');
          current.className = 't-line';
          body.appendChild(current);
        }
        function tick() {
          if (lineIdx >= plain.length) {
            setTimeout(function () { body.innerHTML = ''; lineIdx = 0; charIdx = 0; newLine(); tick(); }, 5200);
            return;
          }
          if (!current) newLine();
          var text = plain[lineIdx];
          charIdx++;
          current.textContent = text.slice(0, charIdx);
          if (charIdx >= text.length) {
            current.innerHTML = lines[lineIdx].html;
            lineIdx++; charIdx = 0; current = null;
            setTimeout(tick, 340);
          } else {
            setTimeout(tick, 22);
          }
        }
      })();

      // Scroll spy for the left rail. Scroll-position based: the active
      // section is the last one whose top has passed a quarter of the
      // viewport, so a section scrolled to the top (e.g. after clicking
      // its rail link) is the active one, and a short section like #who
      // is never skipped for the section after it.
      (function () {
        var ids = ['product', 'who', 'problem', 'engagement', 'how', 'contact'];
        var links = {};
        ids.forEach(function (id) {
          var a = document.querySelector('[data-spy="' + id + '"]');
          if (a) links[id] = a;
        });
        function spy() {
          var pos = window.scrollY + window.innerHeight * 0.25;
          var current = ids[0];
          ids.forEach(function (id) {
            var el = document.getElementById(id);
            if (el && el.getBoundingClientRect().top + window.scrollY <= pos) current = id;
          });
          ids.forEach(function (id) {
            if (links[id]) links[id].classList.toggle('active', id === current);
          });
        }
        window.addEventListener('scroll', spy, { passive: true });
        spy();
      })();
    </script>
  </body>
</html>
